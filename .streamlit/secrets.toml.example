# Copia este archivo a ".streamlit/secrets.toml" (no a este nombre) y
# completa los valores reales. NUNCA subas "secrets.toml" a GitHub — ya
# está en .gitignore.
#
# Estos dos secrets solo son necesarios para desplegar la app en
# Streamlit Community Cloud (compartirla con un link). Para uso local
# en tu computador, sigue usando tu archivo ".env" como siempre.

OPENAI_API_KEY = "sk-..."

# Contraseña simple para que no cualquiera con el link use tu API key.
# Compártela solo con la persona a la que le pasaste el link.
APP_PASSWORD = "elige-una-clave"
